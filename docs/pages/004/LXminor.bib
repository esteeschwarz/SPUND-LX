@incollection{walker_t_2022,
	address = {Amsterdam},
	series = {{NOWELE} {Supplement} {Series}},
	title = {Der \textit{an’t} -{Progressiv} im {Saterfriesischen}},
	volume = {33},
	isbn = {978-90-272-1016-6 978-90-272-5826-7},
	url = {https://benjamins.com/catalog/nss.33.13lak},
	doi = {10.1075/nss.33.13lak},
	abstract = {Abstract
            
              Progressive constructions have been studied across a range of West Germanic languages but not yet in Saterland Frisian. Over five-hundred sentences of the
              an’t
              -progressive, collected from Saterland Frisian spoken and written materials, form the core of this study. Based on the surveyed material, the main characteristics of the construction are identified and explained: usage, types of verbs employed, noun incorporation, and how the
              an’t
              -progressive interacts with the postural verb progressive construction. The research complements earlier studies that investigated equivalents of the
              an’t
              -progressive construction in West Frisian and North Frisian as well as in varieties of German, Dutch and Afrikaans.},
	language = {en},
	urldate = {2026-11-14},
	booktitle = {From {West} to {North} {Frisia}},
	publisher = {John Benjamins Publishing Company},
	author = {Laker, Stephen and Kramer, Pyt},
	editor = {Walker, Alastair and Hoekstra, Eric and Jensma, Goffe and Vanselow, Wendy and Visser, Willem and Winter, Christoph},
	month = mar,
	year = {2022},
	doi = {10.1075/nss.33.13lak},
	note = {laker,kramer (2022) , Progressiv im Saterfriesischen.pdf},
	pages = {206--225},
}

