@book{tynianov_permanent_2019,
	address = {Boston},
	series = {Cultural syllabus},
	title = {Permanent evolution: selected essays on literature, theory and film},
	isbn = {978-1-64469-063-5},
	shorttitle = {Permanent evolution},
	abstract = {"Yuri Tynianov was a key figure of Russian Formalism, an intellectual movement in early 20th century Russia that also included Viktor Shklovsky and Roman Jakobson. Tynianov developed a groundbreaking conceptualization of literature as a system within-and in constant interaction with-other cultural and social systems. His essays on Russian literary classics, like Pushkin's Eugene Onegin and works by Dostoevsky and Gogol, as well as on the emerging art form of filmmaking, provide insight into the ways art and literature evolve and adapt new forms of expression. Although Tynianov was first a scholar of Russian literature, his ideas transcend the boundaries of any one genre or national tradition. Permanent Evolution gathers together for the first time Tynianov's seminal articles on literary theory and film, including several articles never before translated into English"--},
	language = {eng},
	publisher = {Academic Studies Press},
	author = {Tyni︠a︡nov, I︠U︡ N. and Morse, Ainsley and Redko, Philip and Tyni︠a︡nov, I︠U︡ N. and Tyni︠a︡nov, I︠U︡ N.},
	year = {2019},
	note = {Tynianov. On literary evolution.pdf},
	keywords = {History, History and criticism Theory, etc, Motion pictures, Russian literature},
}

