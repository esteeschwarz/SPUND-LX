
@incollection{bach_analogical_2025,
	edition = {1},
	title = {Analogical extension of stress patterns in artificial language learning},
	isbn = {978-0-19-888874-1 978-0-19-199523-1},
	url = {https://academic.oup.com/book/60876/chapter/530436008},
	doi = {10.1093/9780191995231.003.0004},
	abstract = {Abstract
            In many Romance languages, the distribution of stem allomorphs of irregular verbs across the cells of the paradigm correlates with the location of stress, which in some forms is on the stem, in others on the ending. The present study addresses the question of whether the distribution of stress in the paradigm, which is considered to be characteristic of Romance languages, might also have some sort of cognitive reality. In an artificial language learning experiment, the author tests whether the learner’s first language facilitates the acquisition of an artificial miniature language that has the same distribution of stress in the cells of the paradigm as the first language. The results support the assumption that generalizations about paradigmatic structure are not only of descriptive relevance, but may also have some kind of cognitive reality.},
	language = {en},
	urldate = {2026-11-16},
	booktitle = {Comparative and {Dialectal} {Approaches} to {Analogy}},
	publisher = {Oxford University PressOxford},
	author = {Meinschaefer, Judith},
	editor = {Bach, Xavier and Esher, Louise and Gaglia, Sascha},
	month = sep,
	year = {2025},
	note = {Meinschaefer\_2025\_Analogical extension of stress patterns in artificial language learning.pdf},
	pages = {71--90},
}

